# Copy to .env (gitignored). Environment variables override config.json.
# TPP_LLM_PROVIDER=ollama          # ollama | openai | anthropic | gemini | mock
# TPP_LLM_MODEL=qwen2.5:7b
# TPP_LLM_BASE_URL=http://127.0.0.1:11434
# TPP_LLM_API_KEY=
# TPP_EMBED_PROVIDER=auto          # auto | ollama | openai | gemini | mock | none
# TPP_EMBED_MODEL=nomic-embed-text
# TPP_EMBED_BASE_URL=
# TPP_EMBED_API_KEY=
# TPP_PORT=3000
# TPP_DAY_LENGTH_MINUTES=15
# TPP_VILLAGERS=10
# TPP_DEBUG=false
# Provider keys can also be referenced from config via llm.apiKeyEnv, e.g.:
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# GEMINI_API_KEY=
